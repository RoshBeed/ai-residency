# syntax=docker/dockerfile:1
#
# Training image — what a RunPod/AWS GPU host pulls and runs. FROM roshbeed/ai-residency-base
# (built by Dockerfile.base in ai-residency-repo-template, the one shared base every repo in
# the portfolio builds on). ai-residency-common is already installed there, so this file never
# touches git or needs a credential of any kind.
#
# ffmpeg is the real system binary openai-whisper shells out to for audio decoding —
# the pip package of the same name is unrelated and does not provide it. ai-residency-base
# does not install it (it's Week 5-specific), so it's added here.
#
# Build: docker build -f Dockerfile.train -t ai-residency-week5-train .

ARG BASE_IMAGE=roshbeed/ai-residency-base:local
FROM ${BASE_IMAGE}

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

COPY . .
RUN uv sync --frozen

CMD ["uv", "run", "python", "-m", "audio_fine_tuning.training"]
