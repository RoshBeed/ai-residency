# syntax=docker/dockerfile:1
#
# Training image for audio-fine-tuning.
#
# The build context is the repository root, not this directory: the image needs
# the workspace's root pyproject.toml, the single shared uv.lock and libs/common,
# none of which live inside a service.
#
#   docker build -f services/audio-fine-tuning/Dockerfile.train -t roshbeed/ai-residency-audio-fine-tuning-train:latest .
#   (or: make build SERVICE=audio-fine-tuning)

ARG BASE_IMAGE=roshbeed/ai-residency-base:latest
FROM ${BASE_IMAGE}

# openai-whisper shells out to the ffmpeg *binary* to decode audio; the pip
# package of the same name does not provide it.
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Every member's manifest plus the shared lock, before any source. The workspace
# then resolves exactly as it does on a developer machine, and this layer stays
# cached until a dependency actually changes rather than on every code edit.
COPY pyproject.toml uv.lock ./
COPY libs/common/pyproject.toml libs/common/
COPY services/_template/pyproject.toml services/_template/
COPY services/audio-fine-tuning/pyproject.toml services/audio-fine-tuning/
COPY services/content-scoring/pyproject.toml services/content-scoring/
COPY services/frontend/pyproject.toml services/frontend/
COPY services/multimodal-captioning/pyproject.toml services/multimodal-captioning/
COPY services/rlhf-ppo/pyproject.toml services/rlhf-ppo/
COPY services/vector-search-retrieval/pyproject.toml services/vector-search-retrieval/
COPY services/vision-transformers/pyproject.toml services/vision-transformers/
COPY services/word-embeddings/pyproject.toml services/word-embeddings/
# libs/common is a real installable package, so it has to be present before the
# dependency sync can build it -- a manifest alone is not enough.
COPY libs/common libs/common
RUN uv sync --frozen --no-install-project --package ai-residency-audio-fine-tuning

COPY services/audio-fine-tuning services/audio-fine-tuning
RUN uv sync --frozen --package ai-residency-audio-fine-tuning

WORKDIR /app/services/audio-fine-tuning

CMD ["python", "-m", "audio_fine_tuning.training"]
