# syntax=docker/dockerfile:1-labs
#
# Training image for speech-emotion-recognition.
#
# The build context is the repository root, not this directory: the image needs
# the workspace's root pyproject.toml, the single shared uv.lock and libs/common,
# none of which live inside a service.
#
#   docker build -f services/speech-emotion-recognition/Dockerfile.train -t roshb/ai-residency-speech-emotion-recognition-train:latest .
#   (or: make build SERVICE=speech-emotion-recognition)

ARG BASE_IMAGE=roshb/ai-residency-base-train:latest
FROM ${BASE_IMAGE}

# openai-whisper shells out to the ffmpeg *binary* to decode audio; the pip
# package of the same name does not provide it.
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Every member's manifest plus the shared lock, before any source. The workspace
# then resolves exactly as it does on a developer machine, and this layer stays
# cached until a dependency actually changes rather than on every code edit.
COPY pyproject.toml uv.lock ./
# Every workspace member's manifest, before any source, so uv resolves the
# workspace exactly as it does locally and this layer stays cached until a
# dependency actually changes. `--parents` keeps the directory structure, which
# is why this needs no per-member enumeration to go stale.
COPY --parents libs/*/pyproject.toml services/*/pyproject.toml ./
# libs/common is a real installable package, so it has to be present before the
# dependency sync can build it -- a manifest alone is not enough.
COPY libs/common libs/common
# The base already carries the torch build this runtime wants, pinned to the same
# versions as uv.lock. Excluding those three from the sync is what stops uv
# reinstalling the lock's CPU wheels over a CUDA base -- and `--inexact` stops it
# removing them as extraneous.
RUN uv sync --frozen --no-install-project --no-install-package torch --no-install-package torchvision --no-install-package torchaudio --inexact --package ai-residency-speech-emotion-recognition

COPY services/speech-emotion-recognition services/speech-emotion-recognition
RUN uv sync --frozen --no-install-package torch --no-install-package torchvision --no-install-package torchaudio --inexact --package ai-residency-speech-emotion-recognition


WORKDIR /app/services/speech-emotion-recognition

# Drop to the unprivileged user the base image created. Everything above this line
# installs; nothing below it needs root. The service directory is chowned because a
# few services write into it at run time (temp files, a checkpoint directory), and a
# root-owned working directory would make those fail on the first request instead of
# at build time. UID 1000 matches securityContext.runAsUser in the Helm chart.
RUN chown -R app:app /app/services/speech-emotion-recognition
USER app

CMD ["python", "-m", "speech_emotion_recognition.training"]
