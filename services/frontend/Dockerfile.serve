# syntax=docker/dockerfile:1-labs
#
# The published frontend image (roshbeed/ai-residency-frontend): streamlit and
# requests, no ML dependencies at all. Every model runs in its own service's
# container; this one renders pages and makes HTTP calls.
#
# It does not build FROM ai-residency-base-serve, deliberately -- that image carries a
# torch install this one has no use for.
#
# The build context is the repository root, not this directory.
#
#   docker build -f services/frontend/Dockerfile.serve -t roshbeed/ai-residency-frontend:latest .
#   (or: make build SERVICE=frontend)
#
# Named Dockerfile.serve like every other service's, so the one CI job and the one
# make target reach it without a special case for this directory.

FROM python:3.11-slim

WORKDIR /app
RUN pip install --no-cache-dir uv
ENV UV_PROJECT_ENVIRONMENT=/app/.venv

COPY pyproject.toml uv.lock ./
# Every workspace member's manifest, before any source, so uv resolves the
# workspace exactly as it does locally and this layer stays cached until a
# dependency actually changes. `--parents` keeps the directory structure, which
# is why this needs no per-member enumeration to go stale.
COPY --parents libs/*/pyproject.toml services/*/pyproject.toml ./
COPY libs/common libs/common
RUN uv sync --frozen --no-install-project --package ai-residency-frontend

COPY services/frontend services/frontend

WORKDIR /app/services/frontend
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8501
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
