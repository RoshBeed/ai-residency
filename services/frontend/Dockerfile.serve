# syntax=docker/dockerfile:1-labs
#
# The published frontend image (roshb/ai-residency-frontend): streamlit and
# requests, no ML dependencies at all. Every model runs in its own service's
# container; this one renders pages and makes HTTP calls.
#
# It does not build FROM ai-residency-base-serve, deliberately -- that image carries a
# torch install this one has no use for.
#
# The build context is the repository root, not this directory.
#
#   docker build -f services/frontend/Dockerfile.serve -t roshb/ai-residency-frontend:latest .
#   (or: make build SERVICE=frontend)
#
# Named Dockerfile.serve like every other service's, so the one CI job and the one
# make target reach it without a special case for this directory.

# Pinned by digest for the same reason Dockerfile.base is: the tag is rebuilt on every
# base-OS patch, so an unpinned tag makes two builds of one commit differ.
FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

WORKDIR /app
RUN pip install --no-cache-dir uv

# This image does not build FROM ai-residency-base-serve, so it creates the same
# unprivileged user that image would have provided. UID 1000 matches the chart's
# securityContext.runAsUser, here as everywhere else.
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home --home-dir /home/app app
ENV UV_PROJECT_ENVIRONMENT=/app/.venv

COPY pyproject.toml uv.lock ./
# Every workspace member's manifest, before any source, so uv resolves the
# workspace exactly as it does locally and this layer stays cached until a
# dependency actually changes. `--parents` keeps the directory structure, which
# is why this needs no per-member enumeration to go stale.
COPY --parents libs/*/pyproject.toml services/*/pyproject.toml ./
COPY libs/common libs/common
RUN uv sync --frozen --no-install-project --package ai-residency-frontend

COPY services/frontend services/frontend

WORKDIR /app/services/frontend
ENV PATH="/app/.venv/bin:$PATH"
# Drop to the unprivileged user the base image created. Everything above this line
# installs; nothing below it needs root. The service directory is chowned because a
# few services write into it at run time (temp files, a checkpoint directory), and a
# root-owned working directory would make those fail on the first request instead of
# at build time. UID 1000 matches securityContext.runAsUser in the Helm chart.
RUN chown -R app:app /app/services/frontend
USER app

EXPOSE 8501
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
