# syntax=docker/dockerfile:1
#
# Training image — what a RunPod/AWS GPU host pulls and runs. FROM roshbeed/ai-residency-base
# (built by ai-residency-repo-template's Dockerfile.base, the one shared base every repo in
# the portfolio builds on). ai-residency-common is already installed there, so this file
# never touches git or needs a credential of any kind.
#
# Default: train CBOW embeddings. Override CMD for the corpus stage:
#   docker compose run train uv run python -m word_embeddings.etl           (corpus)
#
# Build: docker build -f Dockerfile.train -t ai-residency-week1-train .

ARG BASE_IMAGE=roshbeed/ai-residency-base:local
FROM ${BASE_IMAGE}

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

COPY . .
RUN uv sync --frozen

CMD ["uv", "run", "python", "-m", "word_embeddings.train"]
