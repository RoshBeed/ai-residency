# syntax=docker/dockerfile:1
#
# Serving (inference) image — the container Kubernetes runs. FROM roshbeed/ai-residency-base;
# see Dockerfile.train for why this never needs a git credential either.
#
# Model artifacts are NOT baked in — they're large and generated. This image pulls
# them from the Hub via resolve_checkpoint() when none is bind-mounted locally (see
# docker-compose.yml), so a freshly-trained model is always what's served.
#
# Build: docker build -f Dockerfile.serve -t ai-residency-week1-serve .

ARG BASE_IMAGE=roshbeed/ai-residency-base:local
FROM ${BASE_IMAGE}

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

COPY . .
RUN uv sync --frozen

EXPOSE 8000
CMD ["uv", "run", "python", "-m", "serving.api"]
