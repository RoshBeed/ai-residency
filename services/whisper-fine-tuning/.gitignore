# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Third-party corpora. EmoDB arrives as a ~40MB zip from EMODB_URL via
# `make download-data`, annotation files and all, so committing 1,572 of them only
# made every clone carry a copy of something one command fetches.
datasets/

# C extensions
*.so

