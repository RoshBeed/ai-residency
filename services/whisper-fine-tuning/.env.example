# Copy to .env and fill in. The .env file itself is gitignored -- never commit it.
#
# Both are optional. Without them training still runs: checkpoints stay on local
# disk, and metrics go to an offline Weights & Biases run you can `wandb sync`
# later. With them, a run on one machine can be served from another.
#
# On a machine where the portfolio repos sit side by side, a single .env in the
# parent directory covers all of them -- the lookup walks up from the working
# directory. A standalone clone needs its own copy here.

# Hugging Face token with write access. Used to push trained checkpoints, and to
# pull them on a host that did not do the training (an inference box, a fresh
# clone, a submodule checkout). https://huggingface.co/settings/tokens
HF_TOKEN=

# Weights & Biases API key, for online metric tracking.
# https://wandb.ai/authorize
WANDB_API_KEY=
