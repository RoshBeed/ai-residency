# Hugging Face Configuration
HUGGINGFACE_TOKEN=your_huggingface_token_here
HUGGINGFACE_REPO_ID=your_username/your_model_repo_name
HUGGINGFACE_MODEL_NAME=vision-transformer-mnist

# Weights & Biases Configuration
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT_NAME=vision-transformer-mnist
WANDB_ENTITY=your_wandb_username
WANDB_RUN_NAME=vit-training-run

# Model Configuration
MODEL_UPLOAD_ENABLED=true
WANDB_LOGGING_ENABLED=true

# Training Configuration
EXPERIMENT_NAME=vit_mnist_experiment
SAVE_BEST_MODEL=true
UPLOAD_TO_HF=true
LOG_TO_WANDB=true

# Optional: Custom Model Paths
CUSTOM_MODEL_PATH=
CUSTOM_DATASET_PATH= 