# AWS Configuration
aws_region = "us-east-1"
instance_type = "g4dn.xlarge"  # 1x NVIDIA T4 GPU, 4 vCPUs, 16 GB RAM
spot_price = "0.50"  # Maximum $0.50 per hour
volume_size = 100

# SSH Configuration
ssh_key_path = "~/.ssh/id_rsa"

# Hugging Face Configuration
hf_token = "hf_your_token_here"  # Get from https://huggingface.co/settings/tokens
hf_repo = "your-username/transformer-models"  # Format: username/repo-name

# Git Repository
git_repo = "https://github.com/your-username/MLX-Week3-Transformers.git"

# Training Configuration
training_type = "both"  # Options: "vit", "seq2seq", "both"
max_training_time = 24  # Maximum training time in hours

# Environment
environment = "training" 