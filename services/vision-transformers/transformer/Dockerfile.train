FROM python:3.13.3-slim

WORKDIR /app
ENV PYTHONPATH=/app

COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY train.py .
COPY model.py .
CMD python train.py  # Ensure model.pth is created in /app
# No changes needed here since /app is already the shared volume