# Keep the build context to what the images actually need. Trained artifacts and generated
# data are bind-mounted by docker-compose instead of baked in, and a stray local virtualenv
# in the context adds well over a gigabyte to every stage.
.git
.venv
.venv*
venv/
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints
notebooks/
*.ipynb
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
wandb/
checkpoints/
data/
