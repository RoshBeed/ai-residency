# syntax=docker/dockerfile:1
#
# Training image — what a RunPod/AWS GPU host pulls and runs. FROM roshbeed/ai-residency-base
# (built by ai-residency-repo-template's Dockerfile.base, the shared base every repo in the
# portfolio builds on). ai-residency-common is already installed there, so this file never
# touches git or needs a credential of any kind.
#
# Default: run the full training pipeline (tokenizer → word2vec → triples → encoder).
# Override CMD for individual stages:
#   docker compose run train uv run python -m cbow.train_tokenizer
#   docker compose run train uv run python -m cbow.train_word2vec
#   docker compose run train uv run python -m data_prep.generate_triples
#   docker compose run train uv run python -m data_prep.tokenize_triples
#
# Build: docker build -f Dockerfile.train -t ai-residency-week2-train .

ARG BASE_IMAGE=roshbeed/ai-residency-base:local
FROM ${BASE_IMAGE}

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

COPY . .
RUN uv sync --frozen

CMD ["uv", "run", "python", "-m", "models.training"]
