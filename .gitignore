# One virtualenv for the whole workspace.
.venv/

__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Credentials. .env.example is the committed template.
.env
!.env.example

# Trained artifacts and corpora live on the Hugging Face Hub, never in git. The
# runtime is ephemeral: every service pulls what it needs at run time and pushes
# what it trains, so nothing here should ever depend on a local copy.
services/*/checkpoints/
services/*/data/
# Also at the repo root: pytest and `python -m ...` run from the root resolve a
# service's `data_dir` and `checkpoint_dir` relative to the cwd, so MNIST lands here
# rather than under the service. 63MB of it got committed once that way.
#
# `/checkpoints/` needs its own rule despite the `*.pt` / `*.pth` patterns below:
# those match the weights but not the metrics sidecar written beside them, so a root
# training run left a stray `checkpoints/<arch>/<arch>_model.json` staged and nothing
# else about the directory ignored.
/data/
/checkpoints/
wandb/

# Intermediates from synthesizing demo audio, which land in whatever directory
# the caller happens to be in.
*.aiff

# `datasets/` is raw third-party corpora in the audio services and a Python
# package of dataset wrappers in the vision ones. Ignoring it wholesale silently
# dropped the vision services' own source -- the same collision the .dockerignore
# had, where it produced an image that built fine and failed at import.
services/whisper-fine-tuning/datasets/
services/speech-emotion-recognition/datasets/

# Model and audio artifacts, wherever they land. Previously each service carried its
# own ~120-line copy of a gitignore for this, nine near-identical files in a repo whose
# root pyproject.toml opens by explaining why copy-pasted config was consolidated. Two
# of those copies were also wrong at that level: a blanket `*.json` would eventually
# eat a config file, and `.python-version` was ignored while the root deliberately
# pins it.
*.pt
*.pth
*.ckpt
*.onnx
*.npy
*.npz
*.pkl
*.wav
*.mp3
*.flac
*.m4a

.DS_Store

# setuptools build metadata
*.egg-info/

# Netron exports: regenerable with `make -C services/<name> onnx`, and 2.8MB of binary
# that no README renders.
services/*/assets/onnx/

# Architecture diagrams: regenerable with `make -C services/<name> graph`, and drawn
# from the built models rather than maintained by hand.
services/*/assets/graphs/

# Run state for the long experiments: which combinations have finished, and the specs
# derived from a probe. Regenerated by rerunning, and meaningless on another machine.
services/*/assets/*.progress
services/*/assets/tower-depths.env
