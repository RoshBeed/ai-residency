# One virtualenv for the whole workspace.
.venv/

__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Credentials. .env.example is the committed template.
.env
!.env.example

# Trained artifacts and datasets live on the Hugging Face Hub, never in git --
# every service resolves them locally-then-Hub at run time.
services/*/checkpoints/
services/*/data/
services/*/datasets/
wandb/

.DS_Store
