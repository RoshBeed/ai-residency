{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ai-residency chart values",
  "description": "Validated by Helm on every install, upgrade, template and lint. This exists because values.yaml drifted: it accumulated keys nothing read any more (hostRoot, hfCachePath) alongside a half-finished comment paragraph, and nothing failed. additionalProperties:false turns a stale or misspelled key into an error at install time instead of a setting that silently does nothing.",
  "type": "object",
  "required": [
    "image",
    "probes",
    "backends",
    "frontend",
    "redis",
    "securityContext"
  ],
  "additionalProperties": false,
  "properties": {
    "hfCache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "hostPath",
            "pvc",
            "none"
          ],
          "description": "hostPath ties the chart to a single node; pvc works on any cluster; none makes every pod download its own copy."
        },
        "hostPath": {
          "type": "string"
        },
        "claimName": {
          "type": "string"
        },
        "mountPath": {
          "type": "string",
          "minLength": 1,
          "description": "Where the cache mounts; must match the image HF_HOME."
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Backends that mount the Hugging Face cache."
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1,
          "description": "One tag names every image in the release. CI publishes all ten under sha-<commit>."
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string",
          "minLength": 1,
          "description": "Docker Hub account; repository names derive from it and the chart name."
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "pod": {
          "type": "object",
          "properties": {
            "runAsUser": {
              "type": "integer",
              "minimum": 1,
              "description": "Must match the UID the images create (1000). Kubernetes overrides the image's USER, so a mismatch yields a container that starts and then cannot write."
            },
            "runAsNonRoot": {
              "type": "boolean"
            },
            "runAsGroup": {
              "type": "integer",
              "minimum": 1
            },
            "fsGroup": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "container": {
          "type": "object"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "hfToken": {
          "type": "string"
        },
        "wandbApiKey": {
          "type": "string"
        }
      }
    },
    "train": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "only": {
          "type": "string"
        },
        "runName": {
          "type": "string"
        },
        "env": {
          "type": "object"
        },
        "imageTag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "healthPath",
        "readyPath"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "healthPath": {
          "type": "string",
          "description": "Liveness. Always 200, so a slow or missing checkpoint never restarts a pod."
        },
        "readyPath": {
          "type": "string",
          "description": "Readiness. 503 until the service can serve. Must NOT be the same path as healthPath -- that gives a readiness probe that cannot fail."
        },
        "startup": {
          "type": "object"
        },
        "readiness": {
          "type": "object"
        },
        "liveness": {
          "type": "object"
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": [
        "containerPort",
        "servicePort"
      ],
      "properties": {
        "image": {
          "type": "string",
          "description": "Optional override. Derived as <registry>/<chart>-frontend when absent."
        },
        "containerPort": {
          "type": "integer"
        },
        "servicePort": {
          "type": "integer"
        },
        "healthPath": {
          "type": "string"
        },
        "cpuRequest": {
          "type": "string"
        },
        "memoryRequest": {
          "type": "string"
        },
        "memoryLimit": {
          "type": "string"
        },
        "service": {
          "type": "object"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Pages the UI shows; empty means every backend this release deploys."
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Immutable image digest from deploy/images.yaml; overrides image.tag."
        }
      }
    },
    "redis": {
      "type": "object",
      "required": [
        "image",
        "port",
        "serviceName"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": ":",
          "description": "Must carry an explicit tag. `latest` changes what a release brings up between two installs of the same chart version."
        },
        "command": {
          "type": "array"
        },
        "port": {
          "type": "integer"
        },
        "serviceName": {
          "type": "string"
        },
        "cpuRequest": {
          "type": "string"
        },
        "memoryRequest": {
          "type": "string"
        },
        "memoryLimit": {
          "type": "string"
        }
      }
    },
    "backends": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "description": "Optional override. Derived from the registry, the chart name and this backend's key when absent."
          },
          "trainImage": {
            "type": "string",
            "description": "Optional override. Derived from the registry, the chart name and this backend's key when absent."
          },
          "trainEnv": {
            "type": "object"
          },
          "containerPort": {
            "type": "integer",
            "description": "Optional override of backendDefaults.containerPort"
          },
          "cpuRequest": {
            "type": "string",
            "description": "Optional override of backendDefaults.cpuRequest"
          },
          "memoryRequest": {
            "type": "string"
          },
          "memoryLimit": {
            "type": "string"
          },
          "trainMemoryRequest": {
            "type": "string"
          },
          "trainMemoryLimit": {
            "type": "string"
          },
          "healthPath": {
            "type": "string"
          },
          "readyPath": {
            "type": "string"
          },
          "env": {
            "type": "object"
          },
          "waitForRedis": {
            "type": "boolean"
          },
          "bootstrapCommand": {
            "type": "array"
          },
          "bootstrapOptional": {
            "type": "boolean"
          },
          "volumes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "mountPath"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "mountPath": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "hfCache"
                  ]
                },
                "hostPath": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "readOnly": {
                  "type": "boolean"
                }
              }
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Immutable image digest from deploy/images.yaml; overrides image.tag."
          }
        }
      }
    },
    "backendDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerPort",
        "cpuRequest"
      ],
      "properties": {
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Port every backend listens on unless it overrides it."
        },
        "cpuRequest": {
          "type": "string",
          "minLength": 1,
          "description": "CPU request every backend gets unless it overrides it."
        }
      }
    }
  }
}
