# syntax=docker/dockerfile:1
#
# The shared base, in two variants: python, uv, and the torch stack.
#
# Two variants come out of this one file, because the two runtimes want different
# builds of torch and nothing else differs:
#
#   make base            -> roshbeed/ai-residency-base-serve  (CPU)
#   make base-train      -> roshbeed/ai-residency-base-train  (CUDA, linux/amd64)
#
# Serving containers and laptops take the CPU build -- an unpinned torch drags
# ~10 nvidia-* packages onto a node with no GPU. The training host takes CUDA, or
# `docker run --gpus all` hands it a GPU torch cannot see and training silently
# falls back to CPU.
#
# Versions match uv.lock exactly. Downstream images then sync with
# `--no-install-package torch ... --inexact`, so uv installs everything else the
# lock pins and leaves whichever torch build this image supplied alone. That is
# what keeps the CUDA image from carrying a redundant CPU copy of torch.

FROM python:3.11-slim

ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
ARG TORCH_LOCAL=

RUN pip install --no-cache-dir uv

WORKDIR /app
RUN uv venv .venv

RUN uv pip install --python .venv/bin/python --index-url ${TORCH_INDEX} \
        torch==2.13.0${TORCH_LOCAL} \
        torchvision==0.28.0${TORCH_LOCAL} \
        torchaudio==2.11.0${TORCH_LOCAL}

ENV PATH="/app/.venv/bin:$PATH"
ENV UV_PROJECT_ENVIRONMENT=/app/.venv
