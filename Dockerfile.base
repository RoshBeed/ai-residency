# syntax=docker/dockerfile:1
#
# The shared base, in two variants: python, uv, and the torch stack.
#
# Two variants come out of this one file, because the two runtimes want different
# builds of torch and nothing else differs:
#
#   make base            -> roshb/ai-residency-base-serve  (CPU)
#   make base-train      -> roshb/ai-residency-base-train  (CUDA, linux/amd64)
#
# Serving containers and laptops take the CPU build -- an unpinned torch drags
# ~10 nvidia-* packages onto a node with no GPU. The training host takes CUDA, or
# `docker run --gpus all` hands it a GPU torch cannot see and training silently
# falls back to CPU.
#
# Versions match uv.lock exactly. Downstream images then sync with
# `--no-install-package torch ... --inexact`, so uv installs everything else the
# lock pins and leaves whichever torch build this image supplied alone. That is
# what keeps the CUDA image from carrying a redundant CPU copy of torch.

# Pinned by digest, not just by tag: `python:3.11-slim` is a moving target that is
# rebuilt on every base-OS patch, so two builds of the same commit could otherwise
# produce images with different contents. Refresh it deliberately (and note the bump
# in the commit) rather than drifting into it.
FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
ARG TORCH_LOCAL=

RUN pip install --no-cache-dir uv

WORKDIR /app
RUN uv venv .venv

RUN uv pip install --python .venv/bin/python --index-url ${TORCH_INDEX} \
        torch==2.13.0${TORCH_LOCAL} \
        torchvision==0.28.0${TORCH_LOCAL} \
        torchaudio==2.11.0${TORCH_LOCAL}

ENV PATH="/app/.venv/bin:$PATH"
ENV UV_PROJECT_ENVIRONMENT=/app/.venv

# The unprivileged user every image built on this one runs as. Nothing in this
# portfolio needs root: each container runs a Python process that reads its own code
# and writes a model cache. Running as root anyway is the default only because it is
# the default, and it is the first thing a cluster with Pod Security Standards enforced
# will refuse to schedule.
#
# UID 1000 matches `securityContext.runAsUser` in the Helm chart. They have to agree:
# Kubernetes overrides the image's USER, so a chart running as 1000 against an image
# whose files are owned by root gets a container that starts and then cannot write.
#
# Builds still run as root -- installing dependencies as an unprivileged user fights
# uv for no benefit. Each service Dockerfile switches to this user on its last layer,
# after everything is installed.
RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home --home-dir /home/app app \
    && mkdir -p /home/app/.cache/huggingface \
    && chown -R app:app /home/app

# Where huggingface_hub caches resolved weights. Set here rather than per service so
# the path the chart mounts a volume at, and the path the library actually writes to,
# cannot drift apart.
ENV HF_HOME=/home/app/.cache/huggingface
